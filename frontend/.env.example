# ==============================================================================
# VentureX Frontend - Environment Configuration Template
# ==============================================================================
# Copy to .env.local and fill in. Never commit .env.local.

# FastAPI backend base URL (including /api).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Neon Auth (Managed Better Auth): the auth URL from your Neon project's Auth page.
NEON_AUTH_BASE_URL=

# A long random string used to sign the session cookie, e.g. `openssl rand -base64 32`.
NEON_AUTH_COOKIE_SECRET=
