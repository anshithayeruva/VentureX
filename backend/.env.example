# ==============================================================================
# VentureX Backend - Environment Configuration Template
# ==============================================================================
# Neon variables are pulled automatically into the repo-root .env.local by:
#   neon deploy      (or: neon env pull)
# The backend reads ../.env.local first, then this directory's .env (which wins).
# Copy this file to .env only for app settings or local overrides. Never commit .env.

# Lakebase Postgres on Neon (pooled connection string)
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# How the API talks to Postgres:
#   https (default) = Neon SQL-over-HTTP on port 443 (works where 5432 is blocked)
#   tcp             = psycopg connection pool over port 5432 (lower latency; use on servers)
# NEON_DB_TRANSPORT=https

# Neon Auth (Managed Better Auth) - JWTs from the Next.js app are verified against this JWKS
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=

# Application Settings
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
# Public address of the web app; used for links in emails (set to your real domain in production).
PUBLIC_APP_URL=http://localhost:3000
# Demo projects/investors are inserted only in development. Never enable on a real database.
# SEED_DEMO_DATA=false

# Outgoing email: intro requests, deal-room messages, strong-match alerts.
# Leave SMTP_HOST unset in development: emails are written to logs/emails.log instead.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=notifications@yourdomain.com

# AI project analysis
# AI_PROVIDER: auto (Claude if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY is set,
#              else the rule-based checker) | anthropic | gemini | none
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# Free key at https://aistudio.google.com - free-tier inputs may be used by Google to
# improve its products, so don't analyze confidential decks on the free tier.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is busy (503) or out of quota (429):
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Seconds to wait for each model before moving on:
# GEMINI_TIMEOUT_SECONDS=150
