# ==============================================================================
# VentureX Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values. Never commit .env to version control.

# MongoDB Atlas Configuration
# Obtain your connection string from MongoDB Atlas:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=VentureX

# JWT Authentication
# Generate a strong 32-byte secret (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET_KEY=your_jwt_secret_key_min_32_characters_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# AI Configuration
# Options: none, openai, huggingface, anthropic
AI_PROVIDER=none
