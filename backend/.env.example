# Environment settings for Venture X Backend
ENVIRONMENT=development
PROJECT_NAME="Venture X API"
API_V1_STR=/api

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://venturex:venturex_password@localhost:5432/venturex_db

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future AI/ML & Cloud Service Placeholders
# HUGGINGFACE_API_KEY=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# REDIS_URL=redis://localhost:6379/0
